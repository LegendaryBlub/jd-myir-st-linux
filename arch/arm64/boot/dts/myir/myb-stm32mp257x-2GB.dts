&timers20 {
	status = "okay";
	
	/delete-property/dmas;
	/delete-property/dma-names;

	/* USER CODE BEGIN timers20 */
	timer@19 {
		status = "okay";
	};
	/* USER CODE END timers20 */
};

&adc_3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&adc3_pins_mx>;
	pinctrl-1 = <&adc3_sleep_pins_mx>;
	status = "okay";
	
	vdda-supply = <&scmi_v1v8>;
	vref-supply = <&scmi_v1v8>;

	/* USER CODE BEGIN adc_3 */
	adc3: adc@0 {
		status = "okay";

		channel@3 {
			reg = <3>;
			st,min-sample-time-ns = <10000>;
		};
		
		/delete-node/ channel@14;
		/delete-node/ channel@15;
		/delete-node/ channel@17;
		/delete-node/ channel@18;
	};
	

	/* USER CODE END adc_3 */
};

