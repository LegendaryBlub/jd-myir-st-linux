/dts-v1/;

#define		LVDS_7INCH_PANEL		1
#define		ETH_SWITCH_ENABLE  		0


#include "myb-stm32mp257x-base.dtsi"
#include "myb-stm32mp257x-2GB-resmem.dtsi"
#include "myb-stm32mp257x-ethswitch.dtsi"


/ {
	model = "MYiR STM32MP257x Evaluation Board 2";
	compatible = "myir,myb-stm32mp257x", "st,stm32mp257f-ev1", "st,stm32mp257";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x80000000>;
	};
};

&pinctrl {
	adc3_pins_mx: adc3_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('G', 3, ANALOG)>; /* ADC3_INP3 */
		};
	};

	adc3_sleep_pins_mx: adc3_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('G', 3, ANALOG)>; /* ADC3_INP3 */
		};
	};

	// adc_12_pins_mx: adc_12_mx-0 {
		// pins {
			// pinmux = <STM32_PINMUX('G', 4, ANALOG)>; /* ADC1_INP4 */
		// };
	// };

	// adc_12_sleep_pins_mx: adc_12_sleep_mx-0 {
		// pins {
			// pinmux = <STM32_PINMUX('G', 4, ANALOG)>; /* ADC1_INP4 */
		// };
	// };

	// /* USER CODE BEGIN pinctrl */
	// /* USER CODE END pinctrl */
};

